<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.17763.10</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>Semyra</AssemblyTitle>
    <Product>Semyra Desktop</Product>
    <Company>Semyra Project</Company>
    <Authors>Semyra contributors</Authors>
    <Description>Aplicativo Windows oficial do Semyra.</Description>
    <Copyright>Copyright © 2026 Semyra contributors</Copyright>
    <Version>0.15.0-preview.1</Version>
    <AssemblyVersion>0.15.0.0</AssemblyVersion>
    <FileVersion>0.15.0.0</FileVersion>
    <InformationalVersion>0.15.0-preview.1</InformationalVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="1.6.5" IncludeAssets="compile;runtime" />
    <ProjectReference Include="..\Semyra.MediaHost\Semyra.MediaHost.csproj" />
  </ItemGroup>

</Project>
