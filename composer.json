{
    "name": "josielviega/modelo-php",
    "description": "Starter PHP moderno, simples e seguro para aplicações web tradicionais.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php bin/setup.php",
            "@composer dump-autoload"
        ],
        "serve": "@php bin/serve.php",
        "port:status": "@php bin/port-status.php",
        "port:release": "@php bin/port-release.php",
        "migrate": "@php bin/migrate.php",
        "lint": "@php bin/lint.php",
        "test": "@php vendor/bin/phpunit",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@test"
        ],
        "deploy:hostgator": [
            "@check",
            "@php bin/build-hostgator-mirror.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
