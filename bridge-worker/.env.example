APP_ENV=production
SEMYRA_CONTROL_URL=https://semyra.example.invalid
SEMYRA_WORKER_ID=wrk_replace_with_32_lowercase_hex_chars
SEMYRA_WORKER_SECRET=replace_with_64_lowercase_hex_chars
SEMYRA_SOURCE_CATALOG_PATH=/opt/semyra/bridge-worker/.private/source-catalog.json
SEMYRA_HEARTBEAT_SECONDS=5
SEMYRA_POLL_SECONDS=2
SEMYRA_DOCKER_BIN=docker
SEMYRA_GSTREAMER_IMAGE=livekit/gstreamer:1.22.8-prod-rs
